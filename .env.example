# App
NODE_ENV=development
APP_URL=https://app.kraftsandkodes.com
APP_NAME=KRAFTSANDKODES
MARKETING_URL=https://kraftsandkodes.com

# Database
DATABASE_URL=postgresql://autodm:autodm@localhost:5432/autodm?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Admin-only pages and unlimited plan caps. Founder email is always included.
ADMIN_EMAILS=dev@karandigitallabs.com

# Auth / cookies
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=autodm_session
SESSION_TTL_DAYS=14

# Encrypt Instagram access tokens at rest (64 hex chars = 32 bytes, or any passphrase)
TOKEN_ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase

# Meta / Instagram (never commit real values)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://app.kraftsandkodes.com/api/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=replace-with-webhook-verify-token

# Local development only. Never enable in production.
INSTAGRAM_MOCK_MODE=true

# Razorpay Standard Checkout. KEY_SECRET is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Daily Instagram token refresh cron (Authorization: Bearer …)
CRON_SECRET=

# Google sign-in (web OAuth client). Redirect:
# https://app.kraftsandkodes.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for payment receipts (success and failure)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
